   "source": [
    "experiment = comet_ml.Experiment(\n",
    "    api_key=COMET_API_KEY,\n",
    "    project_name=\"AdaptiveTemperature\",\n",
    "    workspace=\"maksim-bessolitsyn\",\n",
    ")\n",
    "\n",
    "graph = Graph(\n",
    "    vocab_size=vocab_size,\n",
    "    max_seq_len=MAX_LEN,\n",
    "    n_layers=4,\n",
    "    dropout=0.1,\n",
    "    tau=get_tau,\n",
    "    log_q_correction=1,\n",
    "    is_cosine_similarity=True,\n",
    ").cuda()\n",
    "compiled_graph = torch.compile(graph, mode='default')\n",
    "\n",
    "optimizer = torch.optim.AdamW(\n",
    "    compiled_graph.parameters(),\n",
    "    lr=1e-3,\n",
    "    weight_decay=1e-4,\n",
    "    fused=True\n",
    ")\n",
    "\n",
    "train_loop(\n",
    "    compiled_graph,\n",
    "    num_epochs=NUM_EPOCH,\n",
    "    train_dataloader=dataloader,\n",
    "    optimizer=optimizer,\n",
    "    grad_clip=1.0,\n",
    "    grad_accum_steps=1,\n",
    "    writer=experiment,\n",
    ")\n",
    "\n",
    "result = eval_loop(\n",
    "    compiled_graph,\n",
    "    TestDataset(test_histories, batch_size=128),\n",
    "    test_histories=test_histories,\n",
    "    test_targets=test_targets,\n",
    "    item_to_token=item_to_token,\n",
    "    writer=experiment,\n",
    ")\n",
    "\n",
    "experiment.end()\n",
    "\n",
    "result"
   ]
  },
